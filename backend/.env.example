SECRET_KEY=change-me-to-a-random-string
JWT_SECRET_KEY=change-me-to-a-different-random-string
DATABASE_URL=postgresql://localhost/malaria_risk_advisor
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Password reset emails, sent via Brevo's transactional email HTTP API
# (not SMTP — many free hosting tiers block outbound SMTP ports).
# 1. Sign up free at https://www.brevo.com
# 2. Verify a sender email under Senders, Domains & Dedicated IPs > Senders
# 3. Generate an API key under SMTP & API > API Keys
# Leave BREVO_API_KEY unset to fall back to logging the reset link to the
# console instead of emailing it (useful for local dev).
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=your-verified-sender@example.com
BREVO_SENDER_NAME=Malaria Risk Advisor

# Chat assistant (see app/routes/chat.py). Uses Google's Gemini API, which
# has a free tier (no credit card needed) for the Flash models. Get a key
# at https://aistudio.google.com/apikey. Leave unset to disable the
# /api/chat/message endpoint (it returns 503 instead of erroring out).
GEMINI_API_KEY=your-gemini-api-key
CHAT_MODEL=gemini-2.5-flash
