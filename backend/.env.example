SECRET_KEY=change-me-to-a-random-string
JWT_SECRET_KEY=change-me-to-a-different-random-string
DATABASE_URL=postgresql://localhost/malaria_risk_advisor
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Password reset emails, sent via Gmail SMTP.
# MAIL_USERNAME is your full Gmail address.
# MAIL_PASSWORD is a 16-character Gmail "App Password", NOT your normal
# Gmail login password — Google Account > Security > 2-Step Verification
# (must be on) > App passwords > generate one for "Mail".
# Leave both unset to fall back to logging the reset link to the console
# instead of emailing it (useful for local dev without SMTP set up).
MAIL_USERNAME=your-address@gmail.com
MAIL_PASSWORD=your-16-char-app-password
